# Copy to .env and adjust. Every value here has a default in polyarb/config.py.

DATABASE_URL=postgresql+psycopg://localhost/polyarb

# Scanner cadence
SCAN_INTERVAL_SEC=60
REMATCH_INTERVAL_SEC=900

# Print opportunities whose fee-adjusted return (at the profit-maximizing size) is at least this
MIN_RETURN=0.005

# Pairs below this resolution-confidence score are ignored unless you confirm them manually
MIN_MATCH_CONFIDENCE=0.55

# Benchmark for excess annualized return (T-bill yield)
RISK_FREE_RATE=0.04

# Kalshi base taker fee coefficient; each series' fee_multiplier scales it
KALSHI_BASE_FEE=0.07

# Skip markets resolving further out than this (capital lockup makes them uninteresting)
MAX_DAYS_TO_RESOLUTION=400

# Floor on days-to-resolution when annualizing, so same-day markets don't produce absurd APRs
MIN_DAYS_FOR_ANNUALIZATION=1.0

# Log every scanned pair each scan (true) or only pairs whose top-of-book gross return exceeds LOG_GROSS_FLOOR
LOG_ALL_PAIRS=false
LOG_GROSS_FLOOR=-0.02

# Minimum Polymarket liquidity (USD) for a market to enter the matching universe
POLY_MIN_LIQUIDITY=500

# Kalshi read requests per second (basic tier allows 20)
KALSHI_RPS=10
